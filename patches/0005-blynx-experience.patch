+  #blynxPreview.system {
+    --blynx-preview-surface: #252833;
+    --blynx-preview-text: #f1f3f8;
+  }
+}
+
+.blynx-preview-window {
+  background: var(--blynx-preview-surface);
+  border: 1px solid var(--cr-separator-color);
+  border-radius: 12px;
+  color: var(--blynx-preview-text);
+  overflow: hidden;
+}
+
+.blynx-preview-window[data-vertical] { display: flex; }
+
+.blynx-preview-window[data-vertical] .blynx-preview-tabs {
+  flex-direction: column;
+  width: 68px;
+}
+
+.blynx-preview-page { flex: 1;
+ min-width: 0; }
+
+.blynx-preview-tabs { display: flex;
+ gap: 12px;
+ padding: 10px; }
+
+.blynx-preview-tabs span:first-child {
+  border-bottom: 3px solid var(--blynx-preview-accent);
+  padding: 4px;
+}
+
+.blynx-preview-address {
+  border: 1px solid var(--cr-separator-color);
+  border-radius: 20px;
+  margin: 8px;
+  padding: 6px 16px;
+}
+
+.blynx-preview-bookmarks { font-size: 11px;
+ padding: 4px 12px 8px; }
+
+.blynx-preview-canvas {
+  align-items: center;
+  background: radial-gradient(ellipse at top left, #55666f, #171c28 75%);
+  color: #f1f3f8;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  padding: 22px;
+}
+
+.blynx-preview-canvas.midnight { background: linear-gradient(135deg, #1a2441, #0b0f1b); }
+
+.blynx-preview-canvas.paper { background: linear-gradient(135deg, #efe9de, #faf8f1);
+ color: #252833; }
+
+.blynx-preview-canvas .blynx-emblem { flex-basis: 40px;
+ width: 40px; }
+
+.blynx-preview-search {
+  background: var(--blynx-preview-surface);
+  border: 2px solid var(--blynx-preview-accent);
+  border-radius: 20px;
+  height: 22px;
+  max-width: 260px;
+  width: 80%;
+}
+
+.blynx-preview-links { display: flex;
+ gap: 12px; }
+
+.blynx-preview-links[hidden],
+ .blynx-preview-bookmarks[hidden] { display: none; }
+
+.blynx-preview-links span {
+  background: var(--blynx-preview-accent);
+  border-radius: 6px;
+  height: 12px;
+  width: 36px;
+}
+
+#blynxPreview figcaption { color: var(--cr-primary-text-color);
+ font-size: 12px;
+ margin-top: 10px; }
+
+.blynx-preset-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+}
+
+#blynxPresetDescription {
+  line-height: 1.6;
+  margin-top: 20px;
+}
+
+.blynx-setup {
+  background: var(--cr-card-background-color);
+  border: 1px solid var(--cr-separator-color);
+  border-radius: 20px;
+  color: var(--cr-primary-text-color);
+  margin-block-end: 20px;
+  padding: 24px;
+}
+
+.blynx-setup p { line-height: 1.6; }
+
+.blynx-setup-progress { color: var(--cr-secondary-text-color); }
+
+.blynx-setup-actions { display: flex;
+ flex-wrap: wrap;
+ gap: 12px;
+ justify-content: flex-end;
+ margin-block-start: 24px; }
+
+#blynxSetupHeading:focus-visible { outline: 2px solid var(--cr-focus-outline-color);
+ outline-offset: 4px; }
+
+.blynx-setup-links { display: flex;
+ flex-wrap: wrap;
+ gap: 16px;
+ margin-block-start: 16px; }
+
+.blynx-setup-links a { align-content: center;
+ color: var(--cr-link-color);
+ min-height: 24px; }
+
+.blynx-setup-links a:focus-visible { outline: 2px solid var(--cr-focus-outline-color);
+ outline-offset: 4px; }
