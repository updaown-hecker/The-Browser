 .indented-rows .cr-row {
   padding-inline-start: 0;
 }
+
+#blynxAppearance { margin: 8px 20px 28px;
+ padding: 28px;
+ border: 1px solid var(--cr-separator-color);
+ border-radius: 24px;
+ background: linear-gradient(135deg, var(--cr-card-background-color), var(--cr-hover-background-color)); }
+
+.blynx-heading { display: flex;
+ align-items: center;
+ gap: 20px;
+ margin-bottom: 28px; }
+
+.blynx-emblem { flex: 0 0 52px;
+ height: 52px;
+ background: url(chrome://theme/current-channel-logo) center/contain no-repeat; }
+
+.blynx-heading h2 { font-size: 24px;
+ letter-spacing: -.5px;
+ margin: 0 0 8px; }
+
+.blynx-heading p { color: var(--cr-secondary-text-color);
+ line-height: 1.6;
+ margin: 0; }
+
+#blynxAppearance fieldset { border: 0;
+ padding: 0;
+ margin: 0;
+ min-width: 0; }
+
+.blynx-fields { display: grid;
+ grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
+ gap: 20px; }
+
+.blynx-fields label { display: flex;
+ flex-direction: column;
+ gap: 10px;
+ font-weight: 500; }
+
+.blynx-fields select,
+ .blynx-fields input { font: inherit;
+ color: var(--cr-primary-text-color);
+ background: var(--cr-card-background-color);
+ border: 1px solid var(--cr-separator-color);
+ border-radius: 10px;
+ padding: 12px;
