<?xml version="1.0" encoding="utf-8"?>
<grit-part>
  <message name="IDS_BLYNX_AI_TITLE" desc="Blynx assistant panel title.">Blynx assistant</message>
  <message name="IDS_BLYNX_AI_SETUP" desc="Blynx assistant panel settings button.">Settings</message>
  <message name="IDS_BLYNX_AI_CLOSE" desc="Blynx assistant panel close.">Close</message>
  <message name="IDS_BLYNX_AI_ENABLE" desc="Blynx assistant panel enable.">Turn on Blynx assistant</message>
  <message name="IDS_BLYNX_AI_API" desc="Blynx assistant panel api.">Use an API key provider</message>
  <message name="IDS_BLYNX_AI_ENDPOINT" desc="Blynx assistant panel endpoint.">Endpoint URL</message>
  <message name="IDS_BLYNX_AI_MODEL" desc="Blynx assistant panel model.">Custom model name</message>
  <message name="IDS_BLYNX_AI_MODELS" desc="Blynx assistant panel installed model selector.">Installed models</message>
  <message name="IDS_BLYNX_AI_REFRESH_MODELS" desc="Blynx assistant panel refresh model list.">Refresh models</message>
  <message name="IDS_BLYNX_AI_MODEL_HINT" desc="Blynx assistant panel model hint.">Models are detected from Ollama when Settings opens. Choose one, or enter a custom name.</message>
  <message name="IDS_BLYNX_AI_KEY" desc="Blynx assistant panel key.">API key (session only)</message>
  <message name="IDS_BLYNX_AI_KEY_NOTE" desc="Blynx assistant panel key note.">Keys and chat stay in memory. Closing the panel clears the key. Ollama uses no key and unloads after each completed reply.</message>
  <message name="IDS_BLYNX_AI_SPEAK" desc="Blynx assistant panel speech toggle.">Read replies aloud</message>
  <message name="IDS_BLYNX_AI_SPEECH_NOTE" desc="Blynx assistant panel speech note.">Uses the browser's available speech engine. Speech is not sent to the model.</message>
  <message name="IDS_BLYNX_AI_SAVE" desc="Blynx assistant panel save.">Save settings</message>
  <message name="IDS_BLYNX_AI_WELCOME" desc="Blynx assistant panel welcome.">Think it through. Explore the web. Get things done. Connect your model in Settings to start chatting. Enter sends · Shift+Enter adds a line.</message>
  <message name="IDS_BLYNX_AI_SHARE_TABS" desc="Blynx assistant panel share tabs.">Share web tabs</message>
  <message name="IDS_BLYNX_AI_SHARE_PAGE" desc="Blynx assistant panel share page.">Include page text</message>
  <message name="IDS_BLYNX_AI_PLACEHOLDER" desc="Blynx assistant panel placeholder.">Ask me anything…</message>
  <message name="IDS_BLYNX_AI_SEND" desc="Blynx assistant panel send.">Send</message>
  <message name="IDS_BLYNX_AI_STOP" desc="Blynx assistant panel stop.">Stop</message>
  <message name="IDS_BLYNX_AI_NEW_CHAT" desc="Blynx assistant panel new chat.">New chat</message>
  <message name="IDS_BLYNX_AI_READY" desc="Blynx assistant panel ready.">Ready</message>
  <message name="IDS_BLYNX_AI_UNAVAILABLE" desc="Blynx assistant panel unavailable.">Assistant unavailable for this profile or managed/unsupported settings.</message>
  <message name="IDS_BLYNX_AI_STOPPED" desc="Blynx assistant panel stopped.">Stopped</message>
  <message name="IDS_BLYNX_AI_INVALID" desc="Blynx assistant panel invalid.">Check the model and endpoint. Use loopback for Ollama, or HTTPS for an API provider.</message>
  <message name="IDS_BLYNX_AI_SAVED" desc="Blynx assistant panel saved.">Connection saved</message>
  <message name="IDS_BLYNX_AI_ENABLE_FIRST" desc="Blynx assistant panel enable first.">Turn on the assistant in Settings, then save your connection.</message>
  <message name="IDS_BLYNX_AI_PROMPT_LIMIT" desc="Blynx assistant panel prompt limit.">Enter a message up to 8,000 UTF-8 bytes.</message>
  <message name="IDS_BLYNX_AI_KEY_REQUIRED" desc="Blynx assistant panel key required.">Enter your API key in Connection.</message>
  <message name="IDS_BLYNX_AI_THINKING" desc="Blynx assistant panel thinking.">Thinking…</message>
  <message name="IDS_BLYNX_AI_DISCOVERING" desc="Blynx assistant panel model discovery.">Finding your local Ollama models…</message>
  <message name="IDS_BLYNX_AI_MODELS_FOUND" desc="Blynx assistant panel model discovery success.">Models updated</message>
  <message name="IDS_BLYNX_AI_NO_MODELS" desc="Blynx assistant panel no models.">No installed Ollama models found yet.</message>
  <message name="IDS_BLYNX_AI_MODELS_ERROR" desc="Blynx assistant panel model discovery error.">Couldn't reach Ollama. Check that it is running, then refresh.</message>
  <message name="IDS_BLYNX_AI_SPEECH_UNAVAILABLE" desc="Blynx assistant panel speech unavailable.">Speech is unavailable in this browser session.</message>
  <message name="IDS_BLYNX_AI_YOU" desc="Blynx assistant panel you.">You</message>
  <message name="IDS_BLYNX_AI_PAGE_UNAVAILABLE" desc="Blynx assistant panel page unavailable.">The page changed or its text is unavailable. Try again on a web page.</message>
  <message name="IDS_BLYNX_AI_REDIRECT" desc="Blynx assistant panel redirect.">Redirect blocked. Set the final chat endpoint directly.</message>
  <message name="IDS_BLYNX_AI_NETWORK_ERROR" desc="Blynx assistant panel network error.">Connection failed. Check the server, endpoint, model and key; the request may have timed out.</message>
  <message name="IDS_BLYNX_AI_BAD_REPLY" desc="Blynx assistant panel bad reply.">The model returned an unsupported response. No actions were run.</message>
  <message name="IDS_BLYNX_AI_REVIEW" desc="Blynx assistant panel review.">Review proposed browser actions</message>
  <message name="IDS_BLYNX_AI_APPROVE" desc="Blynx assistant panel approve.">Run these actions</message>
  <message name="IDS_BLYNX_AI_DISMISS" desc="Blynx assistant panel dismiss.">Dismiss actions</message>
  <message name="IDS_BLYNX_AI_STALE" desc="Blynx assistant panel stale.">A target tab changed or closed. Ask again before running actions.</message>
  <message name="IDS_BLYNX_AI_ACTIONS_DONE" desc="Blynx assistant panel actions done.">Browser actions dispatched. Check the tabs or settings for the result.</message>
  <message name="IDS_BLYNX_AI_OPEN_TAB" desc="Blynx assistant panel open tab.">Open a new tab</message>
  <message name="IDS_BLYNX_AI_ACTIVATE_TAB" desc="Blynx assistant panel activate tab.">Switch to tab</message>
  <message name="IDS_BLYNX_AI_CLOSE_TAB" desc="Blynx assistant panel close tab.">Close tab</message>
  <message name="IDS_BLYNX_AI_BACK" desc="Blynx assistant panel back.">Go back in tab</message>
  <message name="IDS_BLYNX_AI_FORWARD" desc="Blynx assistant panel forward.">Go forward in tab</message>
  <message name="IDS_BLYNX_AI_RELOAD" desc="Blynx assistant panel reload.">Reload tab</message>
  <message name="IDS_BLYNX_AI_SET_THEME" desc="Blynx assistant panel set theme.">Set browser theme</message>
  <message name="IDS_BLYNX_AI_SET_VERTICAL_TABS" desc="Blynx assistant panel set vertical tabs.">Set vertical tabs</message>
  <message name="IDS_BLYNX_AI_ON" desc="Blynx assistant panel on.">On</message>
  <message name="IDS_BLYNX_AI_OFF" desc="Blynx assistant panel off.">Off</message>
</grit-part>
