diff --git a/chrome/browser/resources/new_tab_page/app.css b/chrome/browser/resources/new_tab_page/app.css
index 37919e3..5ed11f9 100644
--- a/chrome/browser/resources/new_tab_page/app.css
+++ b/chrome/browser/resources/new_tab_page/app.css
@@ -491,3 +491,80 @@ ntp-lens-upload-dialog {
     -webkit-mask-image: url(icons/link.svg);
   }
 }
+
+
+/* Blynx canvas: no remote artwork, respects keyboard focus/reduced motion. */
+#content:is(.aurora, .midnight, .paper) { box-sizing: border-box;
+ min-height: 100vh;
+ padding-top: clamp(60px, 12vh, 140px);
+ padding-bottom: 90px;
+ color: #f4f1eb;
+ background: radial-gradient(ellipse at 20% 5%, #294548 0, transparent 55%), radial-gradient(ellipse at 90% 90%, #373040 0, transparent 55%), #151c21;
+ --color-new-tab-page-primary-foreground: #f4f1eb;
+ --color-new-tab-page-secondary-foreground: #c5cdce;
+ --color-new-tab-page-most-visited-foreground: #f4f1eb; }
+
+#content.midnight { background: radial-gradient(ellipse at 70% 0, #26364b, transparent 65%), #10151e; }
+
+#content.paper { background: radial-gradient(ellipse at 10% 0, #e2e9df, transparent 65%), #f6f3ed;
+ color: #222d2d;
+ --color-new-tab-page-primary-foreground: #222d2d;
+ --color-new-tab-page-secondary-foreground: #536565;
+ --color-new-tab-page-most-visited-foreground: #222d2d; }
+
+#browserFinalBrand { align-items: center;
+ display: flex;
+ flex-direction: column;
+ gap: 18px;
+ margin: 0 24px 32px;
+ text-align: center;
+ max-width: 660px; }
+
+#browserFinalMark { width: 80px;
+ height: 80px;
+ border-radius: 50%;
+ filter: drop-shadow(0 10px 24px rgb(0 0 0 / 22%)); }
+
+#browserFinalBrand h1 { font-size: clamp(36px, 5vw, 48px);
+ font-weight: 500;
+ letter-spacing: -1.8px;
+ margin: 0 0 12px; }
+
+#browserFinalBrand p { font-size: 15px;
+ line-height: 1.7;
+ margin: 0;
+ opacity: .72; }
+
+#browserFinalNavigation { display: flex;
+ flex-wrap: wrap;
+ gap: 8px;
+ justify-content: center;
+ margin: 0 20px 28px;
+ max-width: 700px; }
+
+#browserFinalNavigation[hidden] { display: none; }
+
+#browserFinalNavigation a { border: 1px solid rgb(170 180 180 / 24%);
+ background: rgb(150 160 160 / 7%);
+ border-radius: 12px;
+ color: inherit;
+ font-size: 12px;
+ padding: 11px 17px;
+ text-decoration: none;
+ transition: background 160ms, transform 160ms; }
+
+#browserFinalNavigation a:hover { background: rgb(150 160 160 / 18%);
+ transform: translateY(-2px); }
+
+#browserFinalNavigation a:focus-visible { outline: 3px solid #91c5bf;
+ outline-offset: 3px; }
+
+#oneGoogleBar,
+ #oneGoogleBarStackingContext { display: none; }
+
+#content #searchbox { margin-bottom: 24px; }
+
+:host([show-composebox_]) #browserFinalBrand,
+ :host([show-composebox_]) #browserFinalNavigation,
+ :host([show-voice-search-scrim_]) #browserFinalNavigation { visibility: hidden; }
+@media (prefers-reduced-motion: reduce) { #browserFinalNavigation a { transition: none; } }
