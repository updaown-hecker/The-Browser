+ margin: 24px 0; }
+
+.blynx-toggles label { display: flex;
+ align-items: center;
+ gap: 12px; }
+
+.blynx-toggles input { accent-color: var(--cr-link-color);
+ width: 18px;
+ height: 18px; }
+
+.blynx-actions { display: flex;
+ justify-content: flex-end;
+ gap: 12px; }
+
+#blynxStatus { color: var(--cr-secondary-text-color);
+ margin-bottom: 0; }
+
+#blynxPreview {
+  --blynx-preview-surface: #f1f3f8;
+  --blynx-preview-text: #252833;
+  margin: 20px 0;
+}
+
+#blynxPreview.dark {
+  --blynx-preview-surface: #252833;
+  --blynx-preview-text: #f1f3f8;
+}
+
