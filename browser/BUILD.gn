import("//testing/test.gni")

source_set("browser_identity_appearance") {
  sources = [
    "appearance/appearance_preset.cc",
    "appearance/appearance_preset.h",
    "identity/product_identity.cc",
    "identity/product_identity.h",
  ]

  public = [
    "appearance/appearance_preset.h",
    "identity/product_identity.h",
  ]
}

test("browser_identity_appearance_unittests") {
  sources = [ "tests/browser_identity_appearance_unittests.cc" ]
  deps = [ ":browser_identity_appearance" ]
}

# Leaf PrefService adapter: no dependency on chrome/browser/ui or prefs:impl.
source_set("appearance_prefs") {
  sources = [
    "appearance/appearance_pref_store.cc",
    "appearance/appearance_pref_store.h",
  ]
  public_deps = [
    ":browser_identity_appearance",
    "//base",
    "//components/prefs",
  ]
}

if (!is_android) {
  # The implementations are compiled by //chrome/browser/ui:ui. Toolbar's impl
  # depends only on this header target, avoiding a toolbar -> ui -> toolbar
  # cycle.
  source_set("customization_dialog_headers") {
    sources = [
      "ui/customize_browser_dialog.h",
      "ui/blynx_command_center.h",
      "ui/native_appearance_controller.h",
    ]
    public_deps = [
      ":appearance_prefs",
      "//base",
      "//chrome/browser/profiles:profile",
      "//skia",
      "//ui/gfx",
    ]
  }
}

source_set("chromium_unit_tests") {
  testonly = true
  sources = [ "tests/appearance_pref_store_unittest.cc" ]
  deps = [
    ":appearance_prefs",
    "//base/test:test_support",
    "//components/prefs:test_support",
    "//testing/gtest",
  ]
}

# Run the profile preference adapter tests without linking the entire browser
# or the very large inherited unit_tests target.
test("appearance_prefs_unittests") {
  sources = [ "tests/appearance_prefs_test_main.cc" ]
  deps = [
    ":chromium_unit_tests",
    "//base/test:test_support",
  ]
  data_deps = [ "//third_party/icu:icudata" ]
}

if (!is_android) {
  source_set("chromium_browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "tests/native_appearance_browsertest.cc" ]
    deps = [
      ":appearance_prefs",
      ":customization_dialog_headers",
      "//base",
      "//chrome/browser/policy:test_support",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/themes",
      "//chrome/browser/ui",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/views/frame",
      "//chrome/browser/ui/views/toolbar",
      "//chrome/common",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//components/bookmarks/common",
      "//components/policy/core/common",
      "//components/policy/core/common:test_support",
      "//content/test:test_support",
      "//testing/gtest",
      "//ui/views",
      "//ui/views:test_support",
    ]
    sources += [ "tests/extensions_browsertest.cc" ]
    deps += [
      "//chrome/browser/extensions:test_support",
      "//extensions:test_support",
      "//extensions/browser",
      "//extensions/common",
    ]
  }
}
