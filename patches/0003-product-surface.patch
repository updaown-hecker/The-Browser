diff --git a/chrome/browser/resources/new_tab_page/app.css b/chrome/browser/resources/new_tab_page/app.css
--- a/chrome/browser/resources/new_tab_page/app.css
+++ b/chrome/browser/resources/new_tab_page/app.css
@@ -491,3 +491,75 @@
     -webkit-mask-image: url(icons/link.svg);
   }
 }
+
+/* Browser Final's identity surrounds the upstream search and shortcut UI. */
+#browserFinalBrand {
+  align-items: center;
+  color: var(--color-new-tab-page-primary-foreground);
+  display: flex;
+  gap: 20px;
+  margin: clamp(24px, 7vh, 76px) 24px 28px;
+  max-width: 640px;
+}
+
+#browserFinalMark {
+  align-items: center;
+  background: linear-gradient(135deg, #4f6bed, #8b5cf6);
+  border-radius: 24px;
+  box-shadow: 0 12px 32px rgb(79 107 237 / 20%);
+  color: white;
+  display: flex;
+  flex: 0 0 80px;
+  font-size: 42px;
+  font-weight: 700;
+  height: 80px;
+  justify-content: center;
+}
+
+#browserFinalBrand h1 {
+  font-size: clamp(26px, 4vw, 38px);
+  font-weight: 600;
+  letter-spacing: -1px;
+  margin: 0 0 8px;
+}
+
+#browserFinalBrand p {
+  font-size: 14px;
+  line-height: 1.6;
+  margin: 0;
+  opacity: 0.8;
+}
+
+#browserFinalNavigation {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  justify-content: center;
+  margin: 0 20px 28px;
+  max-width: 640px;
+}
+
+#browserFinalNavigation a {
+  background: var(--color-new-tab-page-background);
+  border: 1px solid var(--color-new-tab-page-primary-foreground);
+  border-radius: 100px;
+  color: var(--color-new-tab-page-primary-foreground);
+  font-size: 13px;
+  padding: 10px 18px;
+  text-decoration: none;
+}
+
+#browserFinalNavigation a:hover {
+  text-decoration: underline;
+}
+
+#browserFinalNavigation a:focus-visible {
+  outline: 3px solid var(--cr-focus-outline-color);
+  outline-offset: 3px;
+}
+
+:host([show-composebox_]) #browserFinalBrand,
+:host([show-composebox_]) #browserFinalNavigation,
+:host([show-voice-search-scrim_]) #browserFinalNavigation {
+  visibility: hidden;
+}
