+  <ntp-logo id="logo" ?single-colored="${this.singleColoredLogo_}"
+      .theme="${this.theme_}" hidden>
+  </ntp-logo>
+  <header id="browserFinalBrand">
+    <img id="browserFinalMark" src="blynx-mark.png" alt="" width="80" height="80">
+    <div>
+      <h1>$i18n{browserFinalName}</h1>
+      <p>$i18n{browserFinalTagline}</p>
+    </div>
+  </header>
+  <nav ?hidden="${!this.blynxLinks_}" id="browserFinalNavigation" aria-label="$i18n{browserFinalNavigation}">
+    <a href="blynx://bookmarks/">$i18n{browserFinalBookmarks}</a>
+    <a href="blynx://history/">$i18n{browserFinalHistory}</a>
+    <a href="blynx://downloads/">$i18n{browserFinalDownloads}</a>
+    <a href="blynx://extensions/">$i18n{browserFinalExtensions}</a>
+    <a href="blynx://settings/">$i18n{browserFinalSettings}</a>
+    <a href="blynx://webstore/">$i18n{blynxExtensionStore}</a>
+  </nav>
   ${this.ntpRealboxNextEnabled_ ? html`
     <div id="scrim"
         @click="${this.onScrimClick_}"
