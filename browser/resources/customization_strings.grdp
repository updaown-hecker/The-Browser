<?xml version="1.0" encoding="utf-8"?>
<!-- 0002-customization.patch installs this catalog beside generated_resources.grd
     as required by that upstream GRD's part-location contract. -->
<grit-part>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_TITLE" desc="Title and toolbar tooltip of Blynx's native appearance dialog.">Customize Blynx</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_DESCRIPTION" desc="Explains which native browser settings can be customized.">Choose a preset or change the theme, accent, and bookmarks bar.</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_PRESET_LABEL" desc="Accessible label for the preset selector.">Appearance preset</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_SAVED" desc="Preset selector entry that restores the configuration loaded when opening the dialog.">Saved configuration</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_PRESET_DEFAULT" desc="Built-in default appearance preset.">Default</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_PRESET_DARK" desc="Built-in dark appearance preset.">Dark</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_PRESET_COMPACT" desc="Built-in compact appearance preset; its density is not yet implemented.">Compact (bookmarks bar on new tabs only)</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_THEME_LABEL" desc="Accessible label for the browser color scheme selector.">Theme mode</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_THEME_SYSTEM" desc="Browser color scheme that follows the operating system's light or dark mode.">Follow system light or dark mode</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_THEME_LIGHT" desc="Light browser color scheme.">Light</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_THEME_DARK" desc="Dark browser color scheme.">Dark</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_ACCENT_LABEL" desc="Label for an RGB hex accent color text field.">Accent color (#RRGGBB)</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_BOOKMARKS" desc="Checkbox controlling bookmark bar visibility on regular tabs. The bar remains visible on new tabs when unchecked.">Show bookmarks bar on all tabs</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_APPLY" desc="Button that applies and saves the selected appearance.">Apply</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_CANCEL" desc="Button that discards appearance edits without changing browser settings.">Cancel</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_PREVIEW" desc="Button that updates a dialog-local illustrative preview without writing preferences.">Preview</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_PREVIEW_NOTICE" desc="Makes the preview's limitations and transactional behavior explicit.">Illustrative preview only. The browser derives its palette from the accent color. Only Apply changes the browser and saves settings; Cancel discards edits. Applying an accent replaces an existing theme.</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_PREVIEW_ACCENT" desc="Text shown on the accent swatch in the illustrative preview.">Accent</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_PREVIEW_BOOKMARKS" desc="Example bookmarks row shown in the illustrative preview of a regular tab.">Example bookmarks</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_UNIMPLEMENTED" desc="Explicitly states which preset fields currently have no effect on native Chromium.">Density, tab shape, background color, scaling, corner radius, animation, transparency, and sidebar settings are stored for compatibility but do not change native browser chrome.</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_READY" desc="Initial status in a writable appearance dialog.">Changes are not saved until you choose Apply.</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_PREVIEW_READY" desc="Status after rendering an illustrative preview.">Preview updated. Browser settings are unchanged.</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_READ_ONLY" desc="Explains refusal to customize incognito, guest, or system profiles.">Open a regular browsing window to customize appearance. Incognito and guest windows cannot save these settings.</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_MANAGED" desc="Explains refusal when any affected appearance setting is controlled by policy, an extension, or a custodian.">Appearance changes are unavailable because a setting is managed or controlled by an extension.</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_UNSUPPORTED" desc="Explains safe handling of appearance JSON from a different schema version.">The saved configuration uses an unsupported version. It has been left unchanged; this version cannot overwrite it.</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_UNAVAILABLE" desc="Explains refusal when appearance services or registered preferences are missing.">Appearance settings are currently unavailable.</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_INVALID_SAVED" desc="Explains a non-mutating fallback after reading malformed or oversized appearance JSON.">The saved configuration could not be read. Default values are shown. Apply will replace the invalid configuration; Cancel leaves it unchanged.</message>
  <message name="IDS_BROWSER_FINAL_CUSTOMIZE_INVALID_INPUT" desc="Error for invalid appearance input, including malformed RGB colors.">Enter a valid RGB accent color such as #4F6BED. No settings have been changed.</message>
  <message name="IDS_BLYNX_SETTINGS_TITLE" desc="Blynx browser settings title UI label.">Blynx Settings</message>
  <message name="IDS_BLYNX_APPEARANCE_TITLE" desc="Blynx browser appearance title UI label.">Make Blynx yours</message>
  <message name="IDS_BLYNX_APPEARANCE_DESCRIPTION" desc="Blynx browser appearance description UI label.">A calmer space for everything you do online. Choose your palette, tabs, and new-tab canvas.</message>
  <message name="IDS_BLYNX_NEWTAB_TITLE" desc="Blynx browser newtab title UI label.">New-tab canvas</message>
  <message name="IDS_BLYNX_NEWTAB_AURORA" desc="Blynx browser newtab aurora UI label.">Aurora</message>
  <message name="IDS_BLYNX_NEWTAB_MIDNIGHT" desc="Blynx browser newtab midnight UI label.">Midnight</message>
  <message name="IDS_BLYNX_NEWTAB_PAPER" desc="Blynx browser newtab paper UI label.">Paper</message>
  <message name="IDS_BLYNX_NEWTAB_LINKS" desc="Blynx browser newtab links UI label.">Show browser shortcuts</message>
  <message name="IDS_BLYNX_SETTINGS_SAVED" desc="Blynx browser settings saved UI label.">Saved. Open a new tab to see your canvas.</message>
  <message name="IDS_BLYNX_SETTINGS_ERROR" desc="Blynx browser settings error UI label.">Changes could not be saved. Check the accent color and whether these settings are managed.</message>
  <message name="IDS_BLYNX_SETTINGS_READ_ONLY" desc="Blynx browser settings read only UI label.">These settings cannot be changed in this profile or are managed.</message>
  <message name="IDS_BLYNX_NEWTAB_TAGLINE" desc="Blynx browser newtab tagline UI label.">Find your focus. Make room for what matters.</message>
  <message name="IDS_BLYNX_EXTENSION_STORE" desc="Blynx browser extension store UI label.">Extensions · Chrome Web Store</message>
  <message name="IDS_BLYNX_PRESET_IMPORT" desc="Button that opens a native file picker for a Blynx appearance preset.">Import preset</message>
  <message name="IDS_BLYNX_PRESET_EXPORT" desc="Button that downloads the saved appearance preset as a JSON file.">Export saved preset</message>
  <message name="IDS_BLYNX_PRESET_DESCRIPTION" desc="Explains the preset file UI and which appearance settings it affects.">Presets include theme, accent, and bookmarks. Tab layout and new-tab canvas stay as chosen. Import a JSON file up to 4 KiB, then preview and Apply.</message>
  <message name="IDS_BLYNX_PRESET_IMPORTED" desc="Status after validating and staging a preset file without saving it.">Preset loaded into the preview. Choose Apply to save it, or Cancel to discard it.</message>
  <message name="IDS_BLYNX_PRESET_IMPORT_ERROR" desc="Status when a preset file cannot be read or fails strict validation.">Choose a valid Blynx appearance preset (JSON, at most 4 KiB). No changes were saved.</message>
  <message name="IDS_BLYNX_PRESET_EXPORTED" desc="Status after starting a download of the saved preset.">Saved preset download started.</message>
  <message name="IDS_BLYNX_PRESET_EXPORT_ERROR" desc="Status when the saved preset cannot be exported safely.">The saved preset could not be exported. Check whether appearance settings are available in this profile.</message>
  <message name="IDS_BLYNX_SETUP_TITLE" desc="Blynx first-run setup title.">Welcome to Blynx</message>
  <message name="IDS_BLYNX_SETUP_WELCOME" desc="Blynx first-run setup welcome.">Your browsing, a little more yours. Bring your bookmarks and supported browser data, then choose a look that feels right.</message>
  <message name="IDS_BLYNX_SETUP_IMPORT_TITLE" desc="Blynx first-run setup import title.">Bring your browsing with you</message>
  <message name="IDS_BLYNX_SETUP_IMPORT_DESCRIPTION" desc="Blynx first-run setup import description.">Choose a detected browser or a bookmarks HTML file in the import dialog. Available data depends on the source browser and your platform. Nothing is imported until you confirm. For other browsers, export bookmarks as HTML and passwords as CSV, then use the matching importer. Password Manager and Extensions open in new tabs. Extensions need reinstalling; sessions and other unsupported data do not transfer automatically.</message>
  <message name="IDS_BLYNX_SETUP_PERSONALIZE_TITLE" desc="Blynx first-run setup personalize title.">Find your look</message>
  <message name="IDS_BLYNX_SETUP_PERSONALIZE_DESCRIPTION" desc="Blynx first-run setup personalize description.">Choose your theme, accent, tabs, and new-tab canvas below. Use Apply to save appearance changes, then start browsing.</message>
  <message name="IDS_BLYNX_SETUP_START" desc="Blynx first-run setup start.">Set up Blynx</message>
  <message name="IDS_BLYNX_SETUP_IMPORT" desc="Blynx first-run setup import.">Choose what to import</message>
  <message name="IDS_BLYNX_SETUP_NEXT" desc="Blynx first-run setup next.">Continue</message>
  <message name="IDS_BLYNX_SETUP_BACK" desc="Blynx first-run setup back.">Back</message>
  <message name="IDS_BLYNX_SETUP_FINISH" desc="Blynx first-run setup finish.">Start browsing</message>
  <message name="IDS_BLYNX_SETUP_SKIP" desc="Blynx first-run setup skip.">Skip setup</message>
  <message name="IDS_BLYNX_SETUP_ERROR" desc="Blynx first-run setup error.">Setup could not be saved. Try again in a regular, unmanaged profile.</message>
</grit-part>
